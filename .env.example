# Public runtime config (Nuxt maps NUXT_PUBLIC_* automatically)
# Full site URL without trailing slash, used for canonical/OG/sitemap
NUXT_PUBLIC_SITE_URL=https://ashkansabbaghi.github.io/sara-ranjbar
# WhatsApp: digits with country code (no +), e.g. 989381482799
NUXT_PUBLIC_WHATSAPP=989381482799
# Phone for the call button: digits with country code (no +)
NUXT_PUBLIC_PHONE=989381482799
# Telegram username without @ (button hidden when empty)
NUXT_PUBLIC_TELEGRAM=
# Instagram handle without @
NUXT_PUBLIC_INSTAGRAM=__sararanjbar
# Private repo the /studio panel writes photos to (owner/name)
NUXT_PUBLIC_CONTENT_REPO=ashkansabbaghi/sara-ranjbar-content
